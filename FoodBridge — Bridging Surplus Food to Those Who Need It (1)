          &lt;button type=&quot;button&quot; data-fill-cred=&quot;admin&quot; class=&quot;py-1.5 px-2 rounded-lg border border-forest-200 bg-forest-50 text-forest-700 font-semibold hover:bg-forest-100&quot;&gt;🛡️ Admin&lt;/button&gt;
