  &lt;/div&gt;

  &lt;!-- Admin Verification &amp; Assignment Modal --&gt;
  &lt;div id=&quot;adminModal&quot; class=&quot;hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4&quot;&gt;
    &lt;div class=&quot;bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl border border-[#E6E1D8]&quot;&gt;
      &lt;div class=&quot;flex items-center justify-between mb-3&quot;&gt;
        &lt;h3 class=&quot;text-lg font-extrabold text-forest-900&quot;&gt;Admin Food Safety Review &amp;amp; Assignment&lt;/h3&gt;
        &lt;button id=&quot;closeAdminModalBtn&quot; type=&quot;button&quot; class=&quot;text-gray-400 hover:text-gray-700 text-lg&quot;&gt;✕&lt;/button&gt;
      &lt;/div&gt;
      &lt;div id=&quot;adminModalDetails&quot; class=&quot;text-xs space-y-2 bg-cream-100 p-4 rounded-xl border border-[#E6E1D8] mb-4&quot;&gt;&lt;/div&gt;
      &lt;div class=&quot;mb-4&quot;&gt;
        &lt;label class=&quot;block text-xs font-bold uppercase text-forest-700 mb-1.5&quot; for=&quot;assignReceiverSelect&quot;&gt;Assign to Verified NGO / Receiver&lt;/label&gt;
        &lt;select id=&quot;assignReceiverSelect&quot; class=&quot;w-full px-3.5 py-2.5 rounded-xl border border-[#D8D2C7] text-sm bg-white&quot;&gt;&lt;/select&gt;
      &lt;/div&gt;
      &lt;div class=&quot;flex flex-wrap justify-end gap-2&quot;&gt;
        &lt;button id=&quot;adminRejectBtn&quot; type=&quot;button&quot; class=&quot;px-4 py-2 rounded-xl border border-red-200 text-red-700 hover:bg-red-50 text-xs font-bold&quot;&gt;Reject / Cancel&lt;/button&gt;
        &lt;button id=&quot;adminApproveOnlyBtn&quot; type=&quot;button&quot; class=&quot;px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold&quot;&gt;🔵 Approve Listing&lt;/button&gt;
        &lt;button id=&quot;adminApproveAssignBtn&quot; type=&quot;button&quot; class=&quot;px-4 py-2 rounded-xl bg-forest-700 hover:bg-forest-800 text-white text-xs font-bold&quot;&gt;🟣 Approve &amp;amp; Assign Receiver&lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- Toast Notification --&gt;
  &lt;div id=&quot;toast&quot; class=&quot;hidden fixed bottom-5 right-5 z-50 max-w-sm bg-forest-900 text-white px-4 py-3 rounded-xl shadow-lg text-sm font-medium border border-forest-600&quot;&gt;&lt;/div&gt;

  &lt;script&gt;
    (function () {
      const STORAGE_KEY = 'foodbridge_demo_state_v2';

      const DEMO_ACCOUNTS = {
        donor: { email: 'donor@foodbridge.demo', pass: 'donor123', role: 'donor', name: 'GreenLeaf Bistro', icon: '🏪', label: 'Donor' },
        admin: { email: 'admin@foodbridge.demo', pass: 'admin123', role: 'admin', name: 'Coordinator Desk', icon: '🛡️', label: 'Admin' },
        receiver: { email: 'receiver@foodbridge.demo', pass: 'receiver123', role: 'receiver', name: 'Hope Community Kitchen', icon: '🤝', label: 'Receiver' }
      };

      const STATUS_META = {
        'Pending Approval': { badge: '🟡 Pending Approval', cls: 'bg-yellow-100 text-yellow-800 border-yellow-200' },
        'Approved': { badge: '🔵 Approved', cls: 'bg-blue-100 text-blue-800 border-blue-200' },
        'Assigned': { badge: '🟣 Assigned', cls: 'bg-purple-100 text-purple-800 border-purple-200' },
        'Awaiting Receiver Confirmation': { badge: '🟠 Awaiting Receiver Confirmation', cls: 'bg-orange-100 text-orange-800 border-orange-200' },
        'Collected': { badge: '🟢 Collected', cls: 'bg-green-100 text-green-800 border-green-200' },
        'Expired / Cancelled': { badge: '⚫ Expired / Cancelled', cls: 'bg-gray-200 text-gray-800 border-gray-300' }
      };

      function buildInitialState() {
        const now = Date.now();
        const hr = 3600 * 1000;
        const receivers = [
          { id: 'rec-1', name: 'Hope Community Kitchen' },
          { id: 'rec-2', name: 'Asha Night Shelter' },
          { id: 'rec-3', name: 'Seva Youth Hostel' },
          { id: 'rec-4', name: 'Care &amp; Share Trust' },
          { id: 'rec-5', name: 'City Elders Home' },
          { id: 'rec-6', name: 'Sunrise Orphanage' },
          { id: 'rec-7', name: 'Neighborhood Food Pantry' },
          { id: 'rec-8', name: 'Mercy Relief Center' }
        ];

        const donations = [
          {
            id: 'DON-1024',
            title: 'Steamed Rice, Sambar &amp; Veg Curry',
            category: 'Cooked Meals',
            weightKg: 14,
            donorName: 'GreenLeaf Bistro',
            location: 'MG Road Kitchen',
            prepTime: new Date(now - 1.5 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now + 4 * hr).toISOString().slice(0, 16),
            storage: 'Hot-held (&gt;60°C)',
            handling: 'Sealed stainless gastronorm trays, untouched catering surplus.',
            status: 'Pending Approval',
            verified: false,
            assignedTo: null
          },
          {
            id: 'DON-1023',
            title: 'Whole Wheat Bread Loaves &amp; Croissants',
            category: 'Bakery &amp; Bread',
            weightKg: 8,
            donorName: 'OvenFresh Bakery',
            location: 'Market Square',
            prepTime: new Date(now - 3 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now + 10 * hr).toISOString().slice(0, 16),
            storage: 'Ambient / Sealed Dry Storage',
            handling: 'Individually wrapped in food-grade paper bags. Contains gluten.',
            status: 'Pending Approval',
            verified: false,
            assignedTo: null
          },
          {
            id: 'DON-1022',
            title: 'Fresh Tomatoes, Carrots &amp; Leafy Greens',
            category: 'Fresh Produce',
            weightKg: 16,
            donorName: 'Metro Mart',
            location: 'Ring Road Depot',
            prepTime: new Date(now - 4 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now + 18 * hr).toISOString().slice(0, 16),
            storage: 'Refrigerated (2–4°C)',
            handling: 'Washed crates, minor surface blemishes only, crisp &amp; edible.',
            status: 'Pending Approval',
            verified: false,
            assignedTo: null
          },
          {
            id: 'DON-1021',
            title: 'Chapati Packs &amp; Paneer Masala',
            category: 'Cooked Meals',
            weightKg: 12,
            donorName: 'Campus Central Mess',
            location: 'North Block Canteen',
            prepTime: new Date(now - 2 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now + 3.5 * hr).toISOString().slice(0, 16),
            storage: 'Hot-held (&gt;60°C)',
            handling: 'Packed in foil boxes. Contains dairy.',
            status: 'Approved',
            verified: true,
            assignedTo: null
          },
          {
            id: 'DON-1020',
            title: 'Fruit Yogurt Cups &amp; Tetra Milk Packs',
            category: 'Dairy &amp; Beverages',
            weightKg: 10,
            donorName: 'DailyFresh Grocer',
            location: 'Station Road',
            prepTime: new Date(now - 5 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now + 5 * hr).toISOString().slice(0, 16),
            storage: 'Refrigerated (2–4°C)',
            handling: 'Unopened retail packs, cold-chain maintained.',
            status: 'Awaiting Receiver Confirmation',
            verified: true,
            assignedTo: 'Hope Community Kitchen'
          },
          {
            id: 'DON-1019',
            title: 'Leftover Sandwich Platters',
            category: 'Cooked Meals',
            weightKg: 6,
            donorName: 'TechPark Cafe',
            location: 'Block C Atrium',
            prepTime: new Date(now - 10 * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now - 1 * hr).toISOString().slice(0, 16),
            storage: 'Refrigerated (2–4°C)',
            handling: 'Past safe pickup window; automatically marked expired.',
            status: 'Expired / Cancelled',
            verified: true,
            assignedTo: null
          }
        ];

        const collectedCats = ['Cooked Meals', 'Fresh Produce', 'Bakery &amp; Bread', 'Packaged Dry Goods', 'Dairy &amp; Beverages'];
        const collectedWeights = [12, 10, 8, 15, 9, 11, 10, 7, 13, 10, 8, 12, 9, 10, 11, 8, 9, 8];
        for (let i = 0; i &lt; 18; i++) {
          const idNum = 1018 - i;
          donations.push({
            id: `DON-${idNum}`,
            title: `Rescued Surplus Batch #${18 - i}`,
            category: collectedCats[i % collectedCats.length],
            weightKg: collectedWeights[i],
            donorName: i % 2 === 0 ? 'GreenLeaf Bistro' : 'Campus Central Mess',
            location: i % 2 === 0 ? 'MG Road Kitchen' : 'North Block Canteen',
            prepTime: new Date(now - (24 + i * 4) * hr).toISOString().slice(0, 16),
            availableUntil: new Date(now - (18 + i * 4) * hr).toISOString().slice(0, 16),
            storage: 'Hot-held (&gt;60°C)',
            handling: 'Verified &amp; collected within safe window.',
            status: 'Collected',
            verified: true,
            assignedTo: receivers[i % receivers.length].name
          });
        }

        return {
          role: 'guest',
          receivers,
          donations,
          statusHistory: [
            { time: 'Today, 16:40', donationId: 'DON-1020', transition: 'Approved → Awaiting Receiver Confirmation', actor: 'Coordinator Desk (Admin)' },
            { time: 'Today, 16:15', donationId: 'DON-1021', transition: 'Pending Approval → Approved', actor: 'Coordinator Desk (Admin)' },
            { time: 'Today, 15:50', donationId: 'DON-1024', transition: 'Created → Pending Approval', actor: 'GreenLeaf Bistro (Donor)' },
            { time: 'Yesterday', donationId: 'DON-1018', transition: 'Awaiting Confirm → Collected', actor: 'Hope Community Kitchen (Receiver)' }
          ],
          receipts: [
            { receiptId: 'RCP-8818', donationId: 'DON-1018', receiver: 'Hope Community Kitchen', weightKg: 12 },
            { receiptId: 'RCP-8817', donationId: 'DON-1017', receiver: 'Asha Night Shelter', weightKg: 10 },
            { receiptId: 'RCP-8816', donationId: 'DON-1016', receiver: 'Seva Youth Hostel', weightKg: 8 }
          ]
        };
      }

      function loadState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) return JSON.parse(raw);
        } catch (e) {}
        return buildInitialState();
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {}
      }

      let state = loadState();
      let currentView = 'home';
      let activeAdminDonationId = null;
      let pendingLoginRole = null;
      let statusChartInstance = null;
      let categoryChartInstance = null;

      function showToast(msg) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.classList.remove('hidden');
        clearTimeout(showToast._t);
        showToast._t = setTimeout(() =&gt; el.classList.add('hidden'), 3600);
      }

      function computeMetrics() {
        const total = state.donations.length;
        const collected = state.donations.filter(d =&gt; d.status === 'Collected');
        return {
          total,
          kgRescued: collected.reduce((sum, d) =&gt; sum + Number(d.weightKg || 0), 0),
          completed: collected.length,
          pending: state.donations.filter(d =&gt; d.status === 'Pending Approval').length,
          activeReceivers: state.receivers.length
        };
      }

      function renderMetrics() {
        const m = computeMetrics();
        document.getElementById('homeStatTotal').textContent = m.total;
        document.getElementById('homeStatKg').textContent = `${m.kgRescued} kg`;
        document.getElementById('homeStatCompleted').textContent = m.completed;
        document.getElementById('homeStatPending').textContent = m.pending;
        document.getElementById('homeStatReceivers').textContent = m.activeReceivers;

        document.getElementById('dashTotal').textContent = m.total;
        document.getElementById('dashKg').textContent = `${m.kgRescued} kg`;
        document.getElementById('dashCompleted').textContent = m.completed;
        document.getElementById('dashPending').textContent = m.pending;
        document.getElementById('dashReceivers').textContent = m.activeReceivers;
      }

      function renderRoleUI() {
        const acc = DEMO_ACCOUNTS[state.role];
        const isGuest = !acc;
        document.getElementById('currentRoleIcon').textContent = isGuest ? '🔒' : acc.icon;
        const displayName = isGuest ? '' : (state.customName || acc.name);
        document.getElementById('currentRoleLabel').textContent = isGuest ? 'Portal Login' : `${acc.label}: ${displayName}`;
        document.getElementById('logoutBtn').classList.toggle('hidden', isGuest);
        document.getElementById('sessionRoleText').textContent = isGuest ? 'Public Visitor' : `${acc.icon} ${acc.label}`;
        document.getElementById('sessionUserText').textContent = isGuest
          ? 'Sign in to access your role-restricted portal (Donor, Admin, or Receiver).'
          : `Authenticated as ${displayName} (${state.customEmail || acc.email})`;

        // Show only authorized portal links in navigation
        document.getElementById('navDonor').classList.toggle('hidden', state.role === 'admin' || state.role === 'receiver');
        document.getElementById('navAdmin').classList.toggle('hidden', state.role !== 'admin');
        document.getElementById('navReceiver').classList.toggle('hidden', state.role !== 'receiver');
        document.getElementById('mobileNavAdmin').classList.toggle('hidden', state.role !== 'admin');
        document.getElementById('mobileNavReceiver').classList.toggle('hidden', state.role !== 'receiver');

        // Enforce strict view gates
        document.getElementById('donorAccessDenied').classList.toggle('hidden', state.role === 'donor');
        document.getElementById('donorPortalContent').classList.toggle('hidden', state.role !== 'donor');

        document.getElementById('adminAccessDenied').classList.toggle('hidden', state.role === 'admin');
        document.getElementById('adminPortalContent').classList.toggle('hidden', state.role !== 'admin');

        document.getElementById('receiverAccessDenied').classList.toggle('hidden', state.role === 'receiver');
        document.getElementById('receiverPortalContent').classList.toggle('hidden', state.role !== 'receiver');
      }

      function getExpiryBadge(availableUntil, status) {
        if (status === 'Collected' || status === 'Expired / Cancelled') return '';
        const diffHrs = (new Date(availableUntil).getTime() - Date.now()) / 3600000;
        if (diffHrs &lt;= 0) return '&lt;span class=&quot;text-[11px] font-bold text-red-700 bg-red-50 px-2 py-0.5 rounded-full border border-red-200&quot;&gt;⏰ Window Passed&lt;/span&gt;';
        if (diffHrs &lt;= 6) return `&lt;span class=&quot;text-[11px] font-bold text-amberwarm-600 bg-amberwarm-50 px-2 py-0.5 rounded-full border border-amberwarm-100&quot;&gt;⏰ ${diffHrs.toFixed(1)}h left&lt;/span&gt;`;
        return `&lt;span class=&quot;text-[11px] font-medium text-forest-700 bg-forest-50 px-2 py-0.5 rounded-full border border-forest-100&quot;&gt;${Math.round(diffHrs)}h left&lt;/span&gt;`;
      }

      function renderDonationCard(d, actionHtml) {
        const meta = STATUS_META[d.status] || STATUS_META['Pending Approval'];
        const expBadge = getExpiryBadge(d.availableUntil, d.status);
        return `
          &lt;div class=&quot;card-eco p-5 flex flex-col justify-between gap-4&quot;&gt;
            &lt;div class=&quot;space-y-2.5&quot;&gt;
              &lt;div class=&quot;flex items-start justify-between gap-2&quot;&gt;
                &lt;span class=&quot;text-[11px] font-bold text-gray-400&quot;&gt;${d.id}&lt;/span&gt;
                &lt;span class=&quot;inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${meta.cls}&quot;&gt;${meta.badge}&lt;/span&gt;
              &lt;/div&gt;
              &lt;h3 class=&quot;text-base font-bold text-forest-900 leading-snug&quot;&gt;${d.title}&lt;/h3&gt;
              &lt;div class=&quot;flex flex-wrap items-center gap-1.5 text-xs&quot;&gt;
                &lt;span class=&quot;px-2 py-0.5 rounded-md bg-cream-200 text-forest-800 font-semibold&quot;&gt;${d.category}&lt;/span&gt;
                &lt;span class=&quot;px-2 py-0.5 rounded-md bg-forest-50 text-forest-700 font-bold&quot;&gt;${d.weightKg} kg&lt;/span&gt;
                ${expBadge}
              &lt;/div&gt;
              &lt;div class=&quot;text-xs text-gray-600 space-y-1 pt-1&quot;&gt;
                &lt;div&gt;&lt;strong&gt;Donor:&lt;/strong&gt; ${d.donorName} • ${d.location}&lt;/div&gt;
                &lt;div&gt;&lt;strong&gt;Storage:&lt;/strong&gt; ${d.storage}&lt;/div&gt;
                &lt;div&gt;&lt;strong&gt;Prepared:&lt;/strong&gt; ${d.prepTime.replace('T', ' ')}&lt;/div&gt;
                &lt;div&gt;&lt;strong&gt;Handling:&lt;/strong&gt; ${d.handling}&lt;/div&gt;
                ${d.assignedTo ? `&lt;div class=&quot;text-purple-700 font-semibold&quot;&gt;&lt;strong&gt;Assigned Receiver:&lt;/strong&gt; ${d.assignedTo}&lt;/div&gt;` : ''}
              &lt;/div&gt;
            &lt;/div&gt;
            ${actionHtml ? `&lt;div class=&quot;pt-3 border-t border-[#F2EDE4]&quot;&gt;${actionHtml}&lt;/div&gt;` : ''}
          &lt;/div&gt;
        `;
      }

      function renderPublicListings() {
        const grid = document.getElementById('donationsGrid');
        const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
        const st = document.getElementById('statusFilter').value;
        const cat = document.getElementById('categoryFilter').value;
        const expOnly = document.getElementById('expiringSoonFilter').checked;

        const filtered = state.donations.filter(d =&gt; {
          if (st !== 'ALL' &amp;&amp; d.status !== st) return false;
          if (cat !== 'ALL' &amp;&amp; d.category !== cat) return false;
          if (expOnly) {
            const diffHrs = (new Date(d.availableUntil).getTime() - Date.now()) / 3600000;
            if (diffHrs &lt;= 0 || diffHrs &gt; 6 || d.status === 'Collected' || d.status === 'Expired / Cancelled') return false;
          }
          if (q) {
            const hay = `${d.id} ${d.title} ${d.donorName} ${d.location} ${d.category}`.toLowerCase();
            if (!hay.includes(q)) return false;
          }
          return true;
        });

        grid.innerHTML = filtered.length
          ? filtered.map(d =&gt; renderDonationCard(d, '')).join('')
          : '&lt;div class=&quot;col-span-full card-eco p-8 text-center text-sm text-gray-500&quot;&gt;No donations match your current filters.&lt;/div&gt;';
      }

      function renderDonorPortal() {
        if (state.role !== 'donor') return;
        const list = state.donations.filter(d =&gt; d.donorName === 'GreenLeaf Bistro');
        document.getElementById('donorMyList').innerHTML = list.map(d =&gt; renderDonationCard(d, '')).join('');
      }

      function renderAdminPortal() {
        if (state.role !== 'admin') return;
        const items = state.donations.filter(d =&gt; d.status === 'Pending Approval' || d.status === 'Approved');
        const grid = document.getElementById('adminGrid');
        grid.innerHTML = items.length
          ? items.map(d =&gt; renderDonationCard(d, `&lt;button type=&quot;button&quot; data-action=&quot;admin-review&quot; data-id=&quot;${d.id}&quot; class=&quot;w-full py-2 rounded-xl bg-forest-700 hover:bg-forest-800 text-white text-xs font-bold transition&quot;&gt;🛡️ Review Safety &amp;amp; Assign&lt;/button&gt;`)).join('')
          : '&lt;div class=&quot;col-span-full card-eco p-8 text-center text-sm text-gray-500&quot;&gt;All pending donations have been reviewed!&lt;/div&gt;';
      }

      function renderReceiverPortal() {
        if (state.role !== 'receiver') return;
        const items = state.donations.filter(d =&gt; d.status === 'Assigned' || d.status === 'Awaiting Receiver Confirmation');
        const grid = document.getElementById('receiverGrid');
        grid.innerHTML = items.length
          ? items.map(d =&gt; {
              const btn = d.status === 'Assigned'
                ? `&lt;button type=&quot;button&quot; data-action=&quot;receiver-confirm&quot; data-id=&quot;${d.id}&quot; class=&quot;w-full py-2 rounded-xl bg-amberwarm-500 hover:bg-amberwarm-600 text-white text-xs font-bold transition&quot;&gt;🤝 Confirm Assigned Pickup&lt;/button&gt;`
                : `&lt;button type=&quot;button&quot; data-action=&quot;receiver-collect&quot; data-id=&quot;${d.id}&quot; class=&quot;w-full py-2 rounded-xl bg-green-700 hover:bg-green-800 text-white text-xs font-bold transition&quot;&gt;🟢 Mark Collected &amp;amp; Issue Receipt&lt;/button&gt;`;
              return renderDonationCard(d, btn);
            }).join('')
          : '&lt;div class=&quot;col-span-full card-eco p-8 text-center text-sm text-gray-500&quot;&gt;No pickups currently awaiting your confirmation.&lt;/div&gt;';
      }

      function renderDashboardTablesAndCharts() {
        document.getElementById('statusHistoryBody').innerHTML = state.statusHistory.slice(0, 12).map(h =&gt; `
          &lt;tr&gt;
            &lt;td class=&quot;py-2 pr-3 text-gray-500 whitespace-nowrap&quot;&gt;${h.time}&lt;/td&gt;
            &lt;td class=&quot;py-2 pr-3 font-bold text-forest-800&quot;&gt;${h.donationId}&lt;/td&gt;
            &lt;td class=&quot;py-2 pr-3 text-gray-700&quot;&gt;${h.transition}&lt;/td&gt;
            &lt;td class=&quot;py-2 text-gray-600&quot;&gt;${h.actor}&lt;/td&gt;
          &lt;/tr&gt;
        `).join('');

        document.getElementById('receiptsBody').innerHTML = state.receipts.slice(0, 12).map(r =&gt; `
          &lt;tr&gt;
            &lt;td class=&quot;py-2 pr-3 font-bold text-forest-800&quot;&gt;${r.receiptId}&lt;/td&gt;
            &lt;td class=&quot;py-2 pr-3 text-gray-700&quot;&gt;${r.donationId}&lt;/td&gt;
            &lt;td class=&quot;py-2 pr-3 text-gray-700&quot;&gt;${r.receiver}&lt;/td&gt;
            &lt;td class=&quot;py-2 font-bold text-green-700&quot;&gt;${r.weightKg} kg&lt;/td&gt;
          &lt;/tr&gt;
        `).join('');

        if (typeof Chart === 'undefined') return;
        const statusKeys = Object.keys(STATUS_META);
        const statusCounts = statusKeys.map(k =&gt; state.donations.filter(d =&gt; d.status === k).length);
        const ctx1 = document.getElementById('statusChart').getContext('2d');
        if (statusChartInstance) statusChartInstance.destroy();
        statusChartInstance = new Chart(ctx1, {
          type: 'bar',
          data: {
            labels: ['Pending', 'Approved', 'Assigned', 'Awaiting Confirm', 'Collected', 'Expired'],
            datasets: [{ label: 'Donations', data: statusCounts, backgroundColor: ['#F59E0B', '#3B82F6', '#8B5CF6', '#E07A2F', '#1B4332', '#6B7280'], borderRadius: 8 }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        const cats = ['Cooked Meals', 'Fresh Produce', 'Bakery &amp; Bread', 'Packaged Dry Goods', 'Dairy &amp; Beverages'];
        const catKg = cats.map(c =&gt; state.donations.filter(d =&gt; d.status === 'Collected' &amp;&amp; d.category === c).reduce((s, d) =&gt; s + Number(d.weightKg || 0), 0));
        const ctx2 = document.getElementById('categoryChart').getContext('2d');
        if (categoryChartInstance) categoryChartInstance.destroy();
        categoryChartInstance = new Chart(ctx2, {
          type: 'doughnut',
          data: { labels: cats, datasets: [{ data: catKg, backgroundColor: ['#1B4332', '#2D6A4F', '#E07A2F', '#74C69D', '#F4A261'] }] },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
      }

      function switchView(viewName) {
        currentView = viewName;
        document.querySelectorAll('.view-section').forEach(sec =&gt; sec.classList.add('hidden'));
        const target = document.getElementById(`view-${viewName}`);
        if (target) target.classList.remove('hidden');

        document.querySelectorAll('.nav-link').forEach(btn =&gt; btn.classList.toggle('active', btn.dataset.nav === viewName));
        document.getElementById('mobileMenu').classList.add('hidden');

        renderRoleUI();
        if (viewName === 'find') renderPublicListings();
        if (viewName === 'donor') renderDonorPortal();
        if (viewName === 'admin') renderAdminPortal();
        if (viewName === 'receiver') renderReceiverPortal();
        if (viewName === 'dashboard') renderDashboardTablesAndCharts();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function recordHistory(donationId, transition, actor) {
        const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        state.statusHistory.unshift({ time: `Today, ${nowStr}`, donationId, transition, actor });
      }

      function openLoginModal(prefillRole, useAutofill = false) {
        document.getElementById('loginError').classList.add('hidden');
        pendingLoginRole = prefillRole || null;
        if (useAutofill &amp;&amp; prefillRole &amp;&amp; DEMO_ACCOUNTS[prefillRole]) {
          document.getElementById('loginName').value = DEMO_ACCOUNTS[prefillRole].name;
          document.getElementById('loginEmail').value = DEMO_ACCOUNTS[prefillRole].email;
          document.getElementById('loginPassword').value = DEMO_ACCOUNTS[prefillRole].pass;
        } else {
          document.getElementById('loginName').value = '';
          document.getElementById('loginEmail').value = '';
          document.getElementById('loginPassword').value = '';
        }
        document.getElementById('authModal').classList.remove('hidden');
      }

      // Event Listeners
      document.querySelectorAll('[data-nav]').forEach(btn =&gt; btn.addEventListener('click', () =&gt; switchView(btn.dataset.nav)));
      document.getElementById('brandBtn').addEventListener('click', () =&gt; switchView('home'));
      document.getElementById('mobileMenuBtn').addEventListener('click', () =&gt; document.getElementById('mobileMenu').classList.toggle('hidden'));
      document.getElementById('openAuthModalBtn').addEventListener('click', () =&gt; openLoginModal());
      document.getElementById('closeAuthModalBtn').addEventListener('click', () =&gt; document.getElementById('authModal').classList.add('hidden'));

      document.querySelectorAll('[data-open-login]').forEach(btn =&gt; btn.addEventListener('click', () =&gt; openLoginModal(btn.dataset.openLogin)));
      document.querySelectorAll('[data-fill-cred]').forEach(btn =&gt; btn.addEventListener('click', () =&gt; openLoginModal(btn.dataset.fillCred, true)));

      document.getElementById('loginForm').addEventListener('submit', e =&gt; {
        e.preventDefault();
        const rawName = document.getElementById('loginName').value.trim();
        const rawEmail = document.getElementById('loginEmail').value.trim();
        const email = rawEmail.toLowerCase();
        const pass = document.getElementById('loginPassword').value;
        if (!rawName || !rawEmail || !pass) {
          const err = document.getElementById('loginError');
          err.textContent = 'Please enter your name, email id, and password.';
          err.classList.remove('hidden');
          return;
        }
        const matched = Object.values(DEMO_ACCOUNTS).find(a =&gt; a.email === email &amp;&amp; a.pass === pass);
        if (matched) {
          state.role = matched.role;
          state.customName = rawName || null;
          state.customEmail = null;
          saveState();
          document.getElementById('authModal').classList.add('hidden');
          showToast(`Signed in to ${matched.label} Portal (${rawName || matched.name})`);
          switchView(matched.role);
          return;
        }
        const inferredRole = pendingLoginRole
          || (['donor', 'admin', 'receiver'].includes(currentView) ? currentView : null)
          || (email.includes('admin') ? 'admin' : email.includes('receiver') ? 'receiver' : 'donor');
        const roleAcc = DEMO_ACCOUNTS[inferredRole];
        state.role = inferredRole;
        state.customName = rawName;
        state.customEmail = rawEmail;
        saveState();
        document.getElementById('authModal').classList.add('hidden');
        showToast(`Signed in to ${roleAcc.label} Portal (${rawName})`);
        switchView(inferredRole);
      });

      document.getElementById('logoutBtn').addEventListener('click', () =&gt; {
        state.role = 'guest';
        state.customName = null;
        state.customEmail = null;
        saveState();
        showToast('Signed out to Public Visitor view.');
        switchView('home');
      });

      document.getElementById('toggleDemoGuideBtn').addEventListener('click', () =&gt; document.getElementById('demoGuidePanel').classList.toggle('hidden'));
      document.getElementById('closeDemoGuideBtn').addEventListener('click', () =&gt; document.getElementById('demoGuidePanel').classList.add('hidden'));

      document.getElementById('resetDemoBtn').addEventListener('click', () =&gt; {
        state = buildInitialState();
        saveState();
        renderMetrics();
        switchView('home');
        showToast('Demo database reset to initial state.');
      });

      document.getElementById('fillSampleDonationBtn').addEventListener('click', () =&gt; {
        const now = Date.now();
        document.getElementById('foodTitle').value = 'Biryani &amp; Raita Family Packs (25 portions)';
        document.getElementById('foodCategory').value = 'Cooked Meals';
        document.getElementById('foodWeight').value = '15';
        document.getElementById('pickupLocation').value = 'GreenLeaf Bistro, Main Avenue';
        document.getElementById('prepTime').value = new Date(now - 3600000).toISOString().slice(0, 16);
        document.getElementById('availableUntil').value = new Date(now + 4 * 3600000).toISOString().slice(0, 16);
        document.getElementById('storageCondition').value = 'Hot-held (&gt;60°C)';
        document.getElementById('handlingInfo').value = 'Packed in sealed food-grade containers, untouched catering surplus. Contains dairy.';
      });

      let isSubmittingDonation = false;
      document.getElementById('donateForm').addEventListener('submit', e =&gt; {
        e.preventDefault();
        if (state.role !== 'donor' || isSubmittingDonation) return;
        isSubmittingDonation = true;
        setTimeout(() =&gt; { isSubmittingDonation = false; }, 600);

        const newId = `DON-${1025 + state.donations.length}`;
        state.donations.unshift({
          id: newId,
          title: document.getElementById('foodTitle').value.trim(),
          category: document.getElementById('foodCategory').value,
          weightKg: Number(document.getElementById('foodWeight').value),
          donorName: 'GreenLeaf Bistro',
          location: document.getElementById('pickupLocation').value.trim(),
          prepTime: document.getElementById('prepTime').value,
          availableUntil: document.getElementById('availableUntil').value,
          storage: document.getElementById('storageCondition').value,
          handling: document.getElementById('handlingInfo').value.trim(),
          status: 'Pending Approval',
          verified: false,
          assignedTo: null
        });
        recordHistory(newId, 'Created → Pending Approval', 'GreenLeaf Bistro (Donor)');
        saveState();
        renderMetrics();
        renderDonorPortal();
        e.target.reset();
        showToast(`Donation ${newId} stored as 🟡 Pending Approval!`);
      });

      document.getElementById('addReceiverForm').addEventListener('submit', e =&gt; {
        e.preventDefault();
        if (state.role !== 'admin') return;
        const input = document.getElementById('newReceiverNameInput');
        const name = input.value.trim();
        if (!name) return;
        if (state.receivers.some(r =&gt; r.name.toLowerCase() === name.toLowerCase())) {
          showToast(`&quot;${name}&quot; is already registered.`);
          return;
        }
        state.receivers.push({ id: `rec-${Date.now()}`, name });
        saveState();
        renderMetrics();
        input.value = '';
        showToast(`Registered &quot;${name}&quot; — Active Receivers is now ${state.receivers.length}.`);
      });

      ['searchInput', 'statusFilter', 'categoryFilter', 'expiringSoonFilter'].forEach(id =&gt; {
        document.getElementById(id).addEventListener('input', renderPublicListings);
        document.getElementById(id).addEventListener('change', renderPublicListings);
      });

      document.getElementById('adminGrid').addEventListener('click', e =&gt; {
        const btn = e.target.closest('[data-action=&quot;admin-review&quot;]');
        if (!btn || state.role !== 'admin') return;
        const d = state.donations.find(x =&gt; x.id === btn.dataset.id);
        if (!d) return;
        activeAdminDonationId = d.id;
        document.getElementById('adminModalDetails').innerHTML = `
          &lt;div&gt;&lt;strong&gt;Donation:&lt;/strong&gt; ${d.id} — ${d.title} (${d.weightKg} kg)&lt;/div&gt;
          &lt;div&gt;&lt;strong&gt;Donor &amp;amp; Location:&lt;/strong&gt; ${d.donorName} (${d.location})&lt;/div&gt;
          &lt;div&gt;&lt;strong&gt;Prep Time:&lt;/strong&gt; ${d.prepTime.replace('T', ' ')} | &lt;strong&gt;Until:&lt;/strong&gt; ${d.availableUntil.replace('T', ' ')}&lt;/div&gt;
          &lt;div&gt;&lt;strong&gt;Storage:&lt;/strong&gt; ${d.storage}&lt;/div&gt;
          &lt;div&gt;&lt;strong&gt;Handling Notes:&lt;/strong&gt; ${d.handling}&lt;/div&gt;
        `;
        document.getElementById('assignReceiverSelect').innerHTML = state.receivers.map(r =&gt; `&lt;option value=&quot;${r.name}&quot;&gt;${r.name}&lt;/option&gt;`).join('');
        document.getElementById('adminModal').classList.remove('hidden');
      });

      document.getElementById('receiverGrid').addEventListener('click', e =&gt; {
        const btn = e.target.closest('[data-action]');
        if (!btn || state.role !== 'receiver') return;
        const d = state.donations.find(x =&gt; x.id === btn.dataset.id);
        if (!d) return;
        if (btn.dataset.action === 'receiver-confirm') {
          const prev = d.status;
          d.status = 'Awaiting Receiver Confirmation';
          recordHistory(d.id, `${prev} → Awaiting Receiver Confirmation`, 'Hope Community Kitchen (Receiver)');
          saveState();
          renderMetrics();
          renderReceiverPortal();
          showToast(`${d.id} confirmed! Ready for collection.`);
        } else if (btn.dataset.action === 'receiver-collect') {
          const prev = d.status;
          d.status = 'Collected';
          recordHistory(d.id, `${prev} → Collected`, 'Hope Community Kitchen (Receiver)');
          state.receipts.unshift({
            receiptId: `RCP-${8819 + state.receipts.length}`,
            donationId: d.id,
            receiver: d.assignedTo || 'Hope Community Kitchen',
            weightKg: d.weightKg
          });
          saveState();
          renderMetrics();
          renderReceiverPortal();
          showToast(`🟢 ${d.id} marked Collected! Dashboard impact updated.`);
        }
      });

      document.getElementById('closeAdminModalBtn').addEventListener('click', () =&gt; document.getElementById('adminModal').classList.add('hidden'));
      document.getElementById('adminApproveOnlyBtn').addEventListener('click', () =&gt; {
        const d = state.donations.find(x =&gt; x.id === activeAdminDonationId);
        if (!d) return;
        const prev = d.status;
        d.status = 'Approved';
        d.verified = true;
        recordHistory(d.id, `${prev} → Approved`, 'Coordinator Desk (Admin)');
        saveState();
        renderMetrics();
        renderAdminPortal();
        document.getElementById('adminModal').classList.add('hidden');
        showToast(`🔵 ${d.id} approved.`);
      });
      document.getElementById('adminApproveAssignBtn').addEventListener('click', () =&gt; {
        const d = state.donations.find(x =&gt; x.id === activeAdminDonationId);
        if (!d) return;
        const receiverName = document.getElementById('assignReceiverSelect').value;
        const prev = d.status;
        d.verified = true;
        d.assignedTo = receiverName;
        d.status = 'Awaiting Receiver Confirmation';
        recordHistory(d.id, `${prev} → Assigned (${receiverName})`, 'Coordinator Desk (Admin)');
        saveState();
        renderMetrics();
        renderAdminPortal();
        document.getElementById('adminModal').classList.add('hidden');
        showToast(`🟣 ${d.id} approved &amp; assigned to ${receiverName}.`);
      });
      document.getElementById('adminRejectBtn').addEventListener('click', () =&gt; {
        const d = state.donations.find(x =&gt; x.id === activeAdminDonationId);
        if (!d) return;
        const prev = d.status;
        d.status = 'Expired / Cancelled';
        recordHistory(d.id, `${prev} → Expired / Cancelled`, 'Coordinator Desk (Admin)');
        saveState();
        renderMetrics();
        renderAdminPortal();
        document.getElementById('adminModal').classList.add('hidden');
        showToast(`⚫ ${d.id} marked Expired / Cancelled.`);
      });

      renderMetrics();
      renderRoleUI();
      renderPublicListings();
    })();
